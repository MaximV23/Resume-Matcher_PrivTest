SESSION_SECRET_KEY="a-secret-key"
SYNC_DATABASE_URL="sqlite:///./app.db"
ASYNC_DATABASE_URL="sqlite+aiosqlite:///./app.db"
PYTHONDONTWRITEBYTECODE=1
# Configure your OpenAI key via either OPENAI_API_KEY or by populating
# both LLM_API_KEY and EMBEDDING_API_KEY below.
# LLM_BASE_URL / EMBEDDING_BASE_URL are optional for OpenAI.
LLM_PROVIDER="ollama"
LLM_BASE_URL="127.0.0.0:11434"
LL_MODEL="gemma3"
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="text-embedding-3-large"
